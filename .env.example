# Copy to .env and fill in. `docker compose` reads this for both interpolation
# and the services' env_file.
#
# The ingest token is shared with every CINC/Chef node that reports in. Changing
# it makes every node start receiving 401 until their data_collector config is
# updated, so keep it stable across redeploys.
CINC_COLLECTOR_TOKEN=change-me

POSTGRES_DB=cinc_collector
POSTGRES_USER=cinc_collector
POSTGRES_PASSWORD=change-me

# Service name of the postgres container inside this compose stack. Only change
# this if you move the database out of the stack.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
